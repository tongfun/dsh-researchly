{
  "name": "dsh-researchly",
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "main": "./lib/index.js",
  "exports": "./lib/index.js",
  "files": ["lib", "cordis.yml"],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "^0.2.2-rc.1"
  },
